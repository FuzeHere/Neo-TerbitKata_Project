# Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/terbitkata?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Cloudinary Configuration (Optional fallback to local storage)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Spam Keywords (Comma-separated)
SPAM_KEYWORDS="slot online,judi online,casino online"
